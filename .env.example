# SecOps-Vault Configuration
PORT=5000
NODE_ENV=production

# Persistence Tier
MONGODB_URI=mongodb://localhost:27017/secops_vault
REDIS_URL=redis://localhost:6379

# Cryptographic Master Key (Must be 32 bytes hex encoded for AES-256)
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VAULT_HMAC_SECRET=secops_vault_audit_hmac_secret_key_2022

# Security & Tokens
VAULT_ROOT_TOKEN=secops_root_token_live_9941
DEFAULT_LEASE_TTL_SECONDS=3600
MAX_LEASE_TTL_SECONDS=86400

# Logging
LOG_LEVEL=info
